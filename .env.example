# Application
DG_ENV=dev
DG_DB_PATH=./data/app.db
DG_SECRET_KEY=change-me-32-bytes-minimum-change-me
DG_COOKIE_SECURE=false
DG_STORAGE_DIR=./data/objects
DG_BASE_URL=http://127.0.0.1:8000

# Model provider (OpenAI-compatible chat completions). Leave empty to use the
# offline fixture provider. Never commit real keys.
DG_LLM_BASE_URL=
DG_LLM_API_KEY=
DG_LLM_TIMEOUT_SECONDS=120

# Second provider family for S2b review.
DG_LLM_B_BASE_URL=
DG_LLM_B_API_KEY=

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DG_STORAGE_KEY=
